# Template only. Copy it OUTSIDE this project and fill it in there:
#   mkdir -p ~/.config/job-search-bot && cp .env.example ~/.config/job-search-bot/.env
# config.py loads that file (or the path in JOB_BOT_ENV_FILE). Exported variables also work.
# Never put real keys in a file inside this folder; the lab proof fails if you do.
OPENAI_API_KEY=
# Optional: Cohere rerank-v3.5. Without it a local cross-encoder reranks.
COHERE_API_KEY=

# Optional overrides
# LLM_MODEL=gpt-5.6-luna
# LLM_MODEL_FAST=gpt-5.4-mini
# REASONING_EFFORT=medium
# RERANKER=auto            # auto | cohere | local | none
# DRIVE_FOLDER_ID=1YthY14bq3JY_5IA3x4O4tS-7PzBEEHn2
