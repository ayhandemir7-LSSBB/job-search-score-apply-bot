# Prefer exporting these in your terminal session (nothing written to disk):
#   export OPENAI_API_KEY=...   export COHERE_API_KEY=...
# A .env file in this folder also works; it is gitignored. Never commit real keys.
OPENAI_API_KEY=
# Optional: Cohere rerank-v3.5. Without it a local cross-encoder reranks.
COHERE_API_KEY=

# Optional overrides
# LLM_MODEL=gpt-5.6-luna
# LLM_MODEL_FAST=gpt-5.4-mini
# REASONING_EFFORT=medium
# RERANKER=auto            # auto | cohere | local | none
# DRIVE_FOLDER_ID=1YthY14bq3JY_5IA3x4O4tS-7PzBEEHn2
